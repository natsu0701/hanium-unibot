# Uni-Bot backend 환경변수 예시 (backend.env.example)

# OpenAI API 키 (필수)
OPENAI_API_KEY=your-openai-api-key-here

# 답변 생성에 사용할 기본 모델 (예: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Self-RAG 검증에 사용할 모델 (예: gpt-4o-mini)
OPENAI_VERIFICATION_MODEL=gpt-4o-mini

# Self-RAG 검증 점수 임계값 (기본 0.7, 0.0~1.0 사이 float)
SELF_RAG_THRESHOLD=0.7

# Upstage API 키 (향후 사용 예정, 없으면 빈 값)
UPSTAGE_API_KEY=your-upstage-api-key-here